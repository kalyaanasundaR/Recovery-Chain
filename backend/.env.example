# RecoverChain runs fully offline with zero config — every var below is optional.

# Database. Default: local SQLite file (no server needed).
# For Postgres: postgresql://user:pass@host:5432/recoverchain  (then `alembic upgrade head`)
# DATABASE_URL=sqlite:///./recoverchain.db

# API key required on mutating endpoints (X-API-Key header). Default: test-api-key
# API_KEY=change-me

# CORS allowlist (comma-separated). Default: * (dev only)
# CORS_ORIGINS=http://localhost:5173

# Redis is OPTIONAL — nothing on the request path uses it. Leave unset to disable.
# REDIS_URL=redis://localhost:6379/0

# ML training quality gate. Defaults: 0.55 / 200. Set to 0 to disable.
# ML_MIN_ROC_AUC=0.55
# ML_MIN_TEST_ROWS=200
